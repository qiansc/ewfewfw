# C4A TypeScript MCP Server Dockerfile
# 用于 mcp-store, mcp-extract, mcp-query, mcp-visual

FROM oven/bun:1.1-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy workspace config
COPY package.json bun.lockb* ./
COPY tsconfig.json ./

# Copy package.json files for dependency resolution
COPY packages/core/package.json packages/core/
COPY packages/mcp-store/package.json packages/mcp-store/
COPY packages/mcp-extract/package.json packages/mcp-extract/
COPY packages/mcp-query/package.json packages/mcp-query/
COPY packages/mcp-visual/package.json packages/mcp-visual/

# Install dependencies
RUN bun install --frozen-lockfile || bun install

# Copy source files
COPY packages/core packages/core
COPY packages/mcp-store packages/mcp-store
COPY packages/mcp-extract packages/mcp-extract
COPY packages/mcp-query packages/mcp-query
COPY packages/mcp-visual packages/mcp-visual

# Default to HTTP transport for Docker
ENV MCP_TRANSPORT=streamable-http

# MCP_SERVER and MCP_PORT are set via docker-compose
# MCP_SERVER: mcp-store, mcp-extract, mcp-query, or mcp-visual
# MCP_PORT: 8051 (store), 8052 (extract), 8054 (query), or 8053 (visual)

# Run the specified MCP server
CMD ["sh", "-c", "bun run packages/${MCP_SERVER}/src/index.ts"]
