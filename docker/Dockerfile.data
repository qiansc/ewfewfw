# C4A Data MCP Server Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install uv for faster package installation
RUN pip install uv

# Copy project files
COPY packages/mcp-data/pyproject.toml ./
COPY packages/mcp-data/src/ ./src/

# Install dependencies
RUN uv pip install --system -e .

# Expose port
EXPOSE 8050

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8050/health || exit 1

# Set transport to HTTP for Docker
ENV MCP_TRANSPORT=streamable-http

CMD ["python", "-m", "c4a_data_mcp.server"]
