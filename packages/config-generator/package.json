{
  "name": "@c4a/config-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "C4A unified config generator for multiple agent platforms",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "c4a-config": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "latest",
    "@types/node": "^20.11.0"
  }
}
