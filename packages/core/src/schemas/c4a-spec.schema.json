{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context4ai.org/schemas/c4a-spec.schema.json",
  "title": "C4A Spec Schema",
  "description": "C4A Spec 实体 Schema",
  "type": "object",
  "required": ["uuid", "root_id", "versions", "id", "type", "name", "status", "scope"],
  "additionalProperties": false,
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "物理主键"
    },
    "root_id": {
      "type": "string",
      "description": "包边界标识"
    },
    "versions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "版本集合（受控字段）"
    },
    "requirement_id": {
      "type": "string",
      "format": "uuid",
      "description": "关联的 Feat UUID（可选，用于追溯来源）"
    },
    "component_id": {
      "type": "string",
      "description": "归属的父 Component（用户可见）"
    },
    "id": {
      "type": "string",
      "description": "Spec ID"
    },
    "type": {
      "type": "string",
      "const": "spec",
      "description": "类型标识"
    },
    "scope": {
      "type": "string",
      "enum": ["domain", "enterprise", "project"],
      "description": "知识层级"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "显示名称"
    },
    "description": {
      "type": "string",
      "description": "描述"
    },
    "kind": {
      "type": "string",
      "enum": ["implementation", "external", "concept"],
      "description": "知识点类型"
    },
    "perspective": {
      "type": "string",
      "enum": ["business", "technical"],
      "description": "视角"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "published", "deprecated", "archived"],
      "description": "生命周期状态"
    },
    "tags": {
      "$ref": "c4a-common.schema.json#/$defs/tags"
    },
    "owner": {
      "$ref": "c4a-common.schema.json#/$defs/owner"
    },
    "links": {
      "type": "array",
      "items": { "$ref": "c4a-common.schema.json#/$defs/link" },
      "description": "相关链接"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "更新时间"
    },
    "created_by": {
      "type": "string",
      "description": "创建者"
    },
    "updated_by": {
      "type": "string",
      "description": "更新者"
    },
    "orphaned": {
      "type": "boolean",
      "description": "是否孤儿实体"
    },
    "orphaned_at": {
      "type": "string",
      "format": "date-time",
      "description": "孤儿标记时间"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Spec 内容"
    }
  }
}
