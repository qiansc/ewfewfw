{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context4ai.org/schemas/c4a-component.schema.json",
  "title": "C4A Component Schema",
  "description": "C4A DSL Component 层定义",

  "type": "object",
  "required": ["schema", "type", "component"],
  "additionalProperties": false,

  "properties": {
    "schema": {
      "const": "c4a/v1",
      "description": "Schema 版本"
    },

    "type": {
      "const": "component",
      "description": "实体类型"
    },

    "component": {
      "type": "object",
      "required": ["id", "name", "description", "scope", "container_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64,
          "description": "组件唯一标识"
        },
        "scope": {
          "type": "string",
          "enum": ["project"],
          "description": "知识层级（Component 仅在 Project 层）"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "组件名称（通常是类名）"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "组件描述"
        },
        "technology": {
          "type": "string",
          "description": "实现技术或设计模式"
        },
        "container_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "所属 Container ID"
        },
        "code_path": {
          "type": "string",
          "description": "代码路径（关联代码目录）"
        },
        "implements_contracts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "实现的契约 ID 列表"
        },
        "references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "引用其他实体（跨层级/跨项目）"
        }
      }
    },

    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to"],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string",
            "description": "目标组件 ID"
          },
          "description": {
            "type": "string",
            "description": "关系描述"
          }
        }
      },
      "description": "组件间依赖关系"
    }
  }
}
