{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context4ai.org/schemas/c4a-contract.schema.json",
  "title": "C4A Contract Schema",
  "description": "C4A API 契约定义",

  "type": "object",
  "required": ["schema", "type", "contract"],
  "additionalProperties": false,

  "properties": {
    "schema": {
      "const": "c4a/v1",
      "description": "Schema 版本"
    },

    "type": {
      "const": "contract",
      "description": "实体类型"
    },

    "contract": {
      "type": "object",
      "required": ["id", "name", "contract_type", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 100,
          "description": "契约唯一标识"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "契约名称"
        },
        "description": {
          "type": "string",
          "description": "契约描述"
        },
        "contract_type": {
          "type": "string",
          "enum": ["openapi", "asyncapi", "proto", "graphql"],
          "description": "契约类型"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "implemented", "published", "deprecated"],
          "description": "契约状态"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "契约版本，如 v1.2.0"
        },

        "implements_sor": {
          "type": "array",
          "items": { "type": "string" },
          "description": "此 Contract 实现的 SoR ID 列表"
        }
      }
    },

    "spec": {
      "type": "object",
      "additionalProperties": true,
      "description": "内联存储规格内容（小型契约，便于版本管理）"
    },

    "spec_uri": {
      "type": "string",
      "description": "外部引用 URI（大型契约，URI 作为唯一标识，不在 C4A 同步范围内）"
    }
  }
}
