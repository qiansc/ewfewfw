{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context4ai.org/schemas/c4a-adr.schema.json",
  "title": "C4A ADR Schema",
  "description": "C4A 架构决策记录 (Architecture Decision Record) 定义",

  "type": "object",
  "required": ["schema", "type", "adr", "context", "decision"],
  "additionalProperties": false,

  "properties": {
    "schema": {
      "const": "c4a/v1",
      "description": "Schema 版本"
    },

    "type": {
      "const": "adr",
      "description": "实体类型"
    },

    "adr": {
      "type": "object",
      "required": ["id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^adr-(?:\\d{3}|[a-z]\\d{3})(?:-[a-z0-9]+)*$",
          "description": "ADR ID，格式：adr-{序号}-{简短描述}，如 adr-001-introduce-mq"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "决策标题"
        },
        "system_id": {
          "type": "string",
          "description": "所属系统 ID"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "published", "deprecated", "archived", "superseded"],
          "description": "ADR 状态"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "决策日期"
        },
        "authors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "作者列表"
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "评审人列表"
        },
        "approved_by": {
          "type": "string",
          "description": "批准人"
        },
        "approved_at": {
          "type": "string",
          "format": "date",
          "description": "批准日期"
        },
        "references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "引用其他实体（跨层级/跨项目）"
        }
      }
    },

    "context": {
      "type": "string",
      "minLength": 1,
      "description": "背景：为什么需要做这个决策"
    },

    "decision": {
      "type": "string",
      "minLength": 1,
      "description": "决策：我们决定做什么"
    },

    "consequences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": { "type": "string" },
          "description": "正面影响"
        },
        "negative": {
          "type": "array",
          "items": { "type": "string" },
          "description": "负面影响"
        },
        "neutral": {
          "type": "array",
          "items": { "type": "string" },
          "description": "中性影响"
        }
      },
      "description": "后果：决策带来的影响"
    },

    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "方案名称"
          },
          "description": {
            "type": "string",
            "description": "方案描述"
          },
          "pros": {
            "type": "array",
            "items": { "type": "string" },
            "description": "优点"
          },
          "cons": {
            "type": "array",
            "items": { "type": "string" },
            "description": "缺点"
          },
          "reason": {
            "type": "string",
            "description": "未选择该方案的原因"
          },
          "evaluation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "评分 1-5"
          }
        }
      },
      "description": "考虑的备选方案"
    },

    "related_entities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "影响的实体 ID 列表"
    },

    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supersedes": {
          "type": "string",
          "pattern": "^adr-(?:\\d{3}|[a-z]\\d{3})(?:-[a-z0-9]+)*$",
          "description": "替代的 ADR ID"
        },
        "superseded_by": {
          "type": "string",
          "pattern": "^adr-(?:\\d{3}|[a-z]\\d{3})(?:-[a-z0-9]+)*$",
          "description": "被哪个 ADR 替代"
        },
        "related_adrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^adr-(?:\\d{3}|[a-z]\\d{3})(?:-[a-z0-9]+)*$"
          },
          "description": "相关 ADR 列表"
        }
      },
      "description": "关联信息"
    }
  }
}
