{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://context4ai.org/schemas/c4a-checklist.schema.json",
  "title": "C4A Checklist Schema",
  "description": "C4A Checklist 实体 Schema",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Checklist 版本"
    },
    "metadata": {
      "type": "object",
      "required": ["feat_id"],
      "additionalProperties": false,
      "properties": {
        "feat_id": {
          "type": "string",
          "description": "关联的 Feat ID"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间"
        },
        "source": {
          "type": "string",
          "description": "生成来源"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "更新时间"
    },
    "updated_by": {
      "type": "string",
      "description": "更新者"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/checklistItem" },
      "description": "任务列表"
    }
  },
  "$defs": {
    "checklistItemStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "skipped"],
      "description": "任务状态"
    },
    "checklistItemType": {
      "type": "string",
      "enum": ["dsl", "code", "test", "doc", "contract"],
      "description": "任务类型"
    },
    "checklistItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "任务 ID"
        },
        "title": {
          "type": "string",
          "description": "任务标题"
        },
        "status": {
          "$ref": "#/$defs/checklistItemStatus"
        },
        "type": {
          "$ref": "#/$defs/checklistItemType"
        },
        "entity_id": {
          "type": "string",
          "description": "关联实体 ID"
        },
        "assignee": {
          "type": "string",
          "description": "负责人"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "完成时间"
        },
        "blocked_reason": {
          "type": "string",
          "description": "阻塞原因"
        }
      }
    }
  }
}
