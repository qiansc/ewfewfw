{
  "name": "c4a",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "ln -sf ../opencode-ai/bin/opencode node_modules/.bin/opencode 2>/dev/null || true",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:cli": "bun run --filter @c4a/cli typecheck",
    "typecheck:cli-dev": "bun run --filter @c4a/cli-dev typecheck",
    "typecheck:storage": "bun run --filter @c4a/storage typecheck",
    "typecheck:core": "bun run --filter @c4a/core typecheck",
    "typecheck:mcp-store": "bun run --filter @c4a/mcp-store typecheck",
    "typecheck:mcp-query": "bun run --filter @c4a/mcp-query typecheck",
    "typecheck:mcp-extract": "bun run --filter @c4a/mcp-extract typecheck",
    "typecheck:mcp-visual": "bun run --filter @c4a/mcp-visual typecheck",
    "typecheck:config-generator": "bun run --filter @c4a/config-generator typecheck",
    "test:cli": "bun run --filter @c4a/cli test",
    "test:cli-dev": "bun run --filter @c4a/cli-dev test",
    "test:storage": "bun run --filter @c4a/storage test",
    "test:core": "bun run --filter @c4a/core test",
    "test:mcp-store": "bun run --filter @c4a/mcp-store test",
    "test:mcp-query": "bun run --filter @c4a/mcp-query test",
    "lint": "bun run --filter '*' lint",
    "config:generate": "bun run ./packages/config-generator/src/index.ts generate",
    "config:validate": "bun run ./packages/config-generator/src/index.ts validate"
  },
  "dependencies": {
    "opencode-ai": "^1.1.4"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/bun": "latest"
  }
}
