# C4A Platform Environment Configuration
# Copy this file to .env and modify as needed

# ===========================================
# Application
# ===========================================
DEBUG=true

# ===========================================
# MongoDB
# ===========================================
MONGODB_URI=mongodb://localhost:27017/c4a
MONGODB_PORT=27017

# ===========================================
# Neo4j
# ===========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=c4a_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===========================================
# Milvus
# ===========================================
MILVUS_URI=http://localhost:19530

# ===========================================
# MCP Server Ports
# ===========================================
STORE_MCP_PORT=8051
EXTRACT_MCP_PORT=8052
QUERY_MCP_PORT=8054
VISUAL_MCP_PORT=8053

# ===========================================
# LLM Configuration (Chat Models)
# ===========================================
# Default LLM provider: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# --- Anthropic/Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_BASE_URL_VERSION=
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# --- Google Gemini ---
GEMINI_API_KEY=

# ===========================================
# Embedding Service Configuration
# ===========================================
# Priority: OPENAI_API_KEY > OLLAMA_HOST
# At least one must be configured for vector search (c4a_query_search)
# and data storage (c4a_store_save) to work.

# --- OpenAI Embedding (1536 dimensions) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama Embedding (768 dimensions, recommended for local dev) ---
# Default uses Docker container: http://ollama:11434
# For local Ollama: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Server 模式 / 集成测试 ---
# 设置后会启用 Server/Remote 模式，并运行 server-integration 相关测试；
# 仅本地模式开发/测试可留空或注释。
# C4A_STORAGE_BACKEND_URL=http://localhost:8055
# 当后端与宿主机共享文件系统时启用 shared（Local ↔ Server 迁移直接读写文件路径）
# C4A_STORAGE_BACKEND_FS=shared
# 共享目录路径（宿主机与后端容器需一致挂载）
# C4A_STORAGE_BACKEND_SHARED_DIR=/tmp/c4a-shared
# 未启用 shared 时，Server→Local 迁移会通过 /utils/download 从 /tmp 或 /var/tmp 拉取备份
