# C4A Platform Environment Configuration
# Copy this file to .env and modify as needed

# ===========================================
# Application
# ===========================================
DEBUG=true

# ===========================================
# MongoDB
# ===========================================
MONGODB_URI=mongodb://localhost:27017/c4a
MONGODB_PORT=27017

# ===========================================
# Neo4j
# ===========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=c4a_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===========================================
# Milvus
# ===========================================
MILVUS_URI=http://localhost:19530

# ===========================================
# MCP Server (Unified Data MCP)
# ===========================================
DATA_MCP_PORT=8050

# ===========================================
# LLM Configuration (Chat Models)
# ===========================================
# Default LLM provider: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# --- Anthropic/Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_BASE_URL_VERSION=
ANTHROPIC_MODEL=claude-opus-4-5-20251101

# --- Google Gemini ---
GEMINI_API_KEY=

# ===========================================
# Embedding Service Configuration
# ===========================================
# Priority: OPENAI_API_KEY > OLLAMA_HOST
# At least one must be configured for vector search (c4a_query_search)
# and data storage (c4a_store_save) to work.

# --- OpenAI Embedding (1536 dimensions) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama Embedding (768 dimensions, recommended for local dev) ---
# Default uses Docker container: http://ollama:11434
# For local Ollama: http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
